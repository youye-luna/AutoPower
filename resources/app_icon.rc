// AutoPower Application Icon Resource

#include <windows.h>

// 资源ID（与 AutoPower_single.cpp 保持一致）
#define IDI_APP_ICON  2001
#define IDB_LOGO_PNG  2002

// 应用程序图标
IDI_APP_ICON ICON "app_icon.ico"

// 关于页面 Logo (PNG)
IDB_LOGO_PNG RCDATA "../AutoPower.png"

// 版本信息
1 VERSIONINFO
FILEVERSION     1,0,2,0
PRODUCTVERSION  1,0,2,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "AutoPower"
            VALUE "FileDescription", "AutoPower Timer Shutdown"
            VALUE "FileVersion", "1.0.2"
            VALUE "InternalName", "AutoPower"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "AutoPower.exe"
            VALUE "ProductName", "AutoPower"
            VALUE "ProductVersion", "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 2052, 1200
    END
END